{
  "name": "cc-setup-agent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check:models": "tsx --conditions=source scripts/check-forbidden-models.ts",
    "keys:generate": "tsx --conditions=source scripts/keys-generate.ts",
    "db:health": "tsx --conditions=source scripts/db-health.ts",
    "db:migrate": "tsx --conditions=source scripts/db-migrate.ts",
    "db:generate": "pnpm --filter @cc-setup-agent/db db:generate",
    "pipeline": "tsx --conditions=source apps/pipeline/src/cli.ts"
  },
  "devDependencies": {
    "@cc-setup-agent/core": "workspace:*",
    "@cc-setup-agent/db": "workspace:*",
    "@cc-setup-agent/shared": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
