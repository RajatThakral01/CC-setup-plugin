# Copy to .env and fill in the secrets. Never commit .env.
# Every non-secret value below shows its default; delete a line to use the default.

# --- Secrets ---
# Local default matches docker-compose.yml; hosted deployments must override.
DATABASE_URL=postgres://setup:setup@localhost:5433/setup_agent
# Needed from Milestone 3 (classification) and Milestone 9 (evals).
ANTHROPIC_API_KEY=
# Fine-grained, read-only, public repositories. Needed from Milestone 2.
GITHUB_TOKEN=
# Path to the Ed25519 private key from `pnpm keys:generate`, outside the repo. Milestone 6.
SNAPSHOT_SIGNING_KEY_PATH=
# Random string protecting the triage UI, required even locally. Milestone 5.
TRIAGE_ADMIN_TOKEN=

# --- Models (Haiku and Sonnet only; any ID containing "opus" is refused) ---
MODEL_FAST=claude-haiku-5-5
MODEL_STRONG=claude-sonnet-5-5
ALLOWED_MODELS=claude-haiku-5-5,claude-sonnet-5-5
# Optional JSON override of per-million-token prices; defaults live in packages/shared/src/config.ts.
# MODEL_PRICING_JSON=

# --- Budget (USD) ---
WEEKLY_BUDGET_USD=20
BUDGET_SPLIT_CLASSIFY_USD=3
# Hard cap across all weeks and purposes for the build and testing phase.
TOTAL_BUDGET_USD=40
TOTAL_BUDGET_WARN_USD=30

# --- Snapshot ---
SNAPSHOT_STORE=github-release
# SNAPSHOT_REPO=owner/cc-setup-agent

# --- Triage UI ---
TRIAGE_HOST=127.0.0.1
TRIAGE_PORT=4400

# --- Evals ---
EVAL_MAX_TURNS=15
EVAL_TIMEOUT_SECONDS=300

# --- HTTP client ---
HTTP_MAX_RETRIES=4
HTTP_BASE_DELAY_MS=500
HTTP_MAX_DELAY_MS=60000
HTTP_TIMEOUT_MS=30000
# Optional JSON override of per-host spacing, e.g. {"api.github.com":{"minIntervalMs":250}}
# HTTP_HOST_RATE_LIMITS_JSON=

# --- Docker Compose ---
POSTGRES_HOST_PORT=5433

LOG_LEVEL=info

# --- External endpoints ---
GITHUB_API_URL=https://api.github.com
GITHUB_RAW_URL=https://raw.githubusercontent.com
NPM_REGISTRY_URL=https://registry.npmjs.org
MCP_REGISTRY_URL=https://registry.modelcontextprotocol.io/v0.1
CLAUDE_CODE_REPO=anthropics/claude-code

# --- Discovery and intake (PRD FR-D10) ---
DISCOVERY_CRON=0 2 * * *
DISCOVERY_LOOKBACK_DAYS=7
GITHUB_SEARCH_TOPICS=mcp-server,claude-code,claude-skills,claude-code-plugin
GITHUB_SEARCH_WINDOW_DAYS=7
GITHUB_SEARCH_MAX_PAGES=10
GITHUB_SEARCH_INTERVAL_MS=2500
REGISTRY_MAX_PAGES=200
CHANGELOG_MAX_VERSIONS=30
INTAKE_MIN_STARS=10
INTAKE_DAILY_CAP=30
INTAKE_REFRESH_LIMIT=200
CLASSIFY_README_CHARS=4000
CLASSIFY_MAX_TOKENS=600
CLASSIFY_DAILY_RECORD_LIMIT=300

# --- Credibility gates (sandbox images: official node/python, tag + digest) ---
GATE_NODE_IMAGE=node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392
GATE_PYTHON_IMAGE=python:3.13-slim-bookworm@sha256:a1165e272e578941b84abc79e4ab38a0305cd12803a5c4247979ac7655f4d641
GATE_INSTALL_TIMEOUT_SECONDS=180
GATE_LIST_TOOLS_TIMEOUT_SECONDS=30
GATE_CPUS=1
GATE_MEMORY_MB=1024
GATE_PIDS_LIMIT=256
GATE_CONCURRENCY=2
GATE_RECHECK_DAYS=30
GATES_CRON=0 4 * * *
OSV_API_URL=https://api.osv.dev/v1
NPM_DOWNLOADS_URL=https://api.npmjs.org
PYPI_URL=https://pypi.org
